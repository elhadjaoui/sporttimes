# ===== Waitlist (Formsubmit.co) =====
# The email that receives waitlist signups. Used by components/ui/Waitlist.tsx.
#
# Two recommended values:
#   1. Your verified email (e.g. ops@sporttimes.app) — submissions email here.
#      Note: exposed in the client JS bundle.
#   2. The random token Formsubmit generates after the first verified submit.
#      Hides the email from the bundle. Recommended for production.
#
# If unset, Waitlist renders but submissions land in the error state.
NEXT_PUBLIC_FORMSUBMIT_EMAIL=
