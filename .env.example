# ===== Waitlist (Google Form, inline submit) =====
# Inline email form posts to a Google Form's formResponse endpoint. See
# components/ui/WaitlistForm.tsx for the fetch logic.
#
# Setup:
#
# 1. Create the Google Form. Turn on "Collect email addresses" under
#    Settings → Responses. Choose "Responder input" so users can type
#    any email (no Google sign-in required).
#
# 2. Copy the form URL from the "Send" button. Either the /viewform or
#    /formResponse variant works — the code handles both. Set it below.
#
# 3. If you used the built-in email collection, EMAIL_ENTRY is the
#    literal string `emailAddress`. If you added a custom email
#    question instead, get its entry ID from ⋮ menu →
#    "Get pre-filled link" (it looks like entry.1234567890).
#
# 4. (Optional) Add a "Source" short-answer question if you want to
#    know which button was clicked. Grab its entry ID the same way.

NEXT_PUBLIC_GOOGLE_FORM_URL=
NEXT_PUBLIC_GOOGLE_FORM_EMAIL_ENTRY=emailAddress
NEXT_PUBLIC_GOOGLE_FORM_SOURCE_ENTRY=
